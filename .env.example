# Gemini API settings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
GEMINI_TIMEOUT_SECONDS=60

# Database settings
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/myfutureabroad

# CORS settings (comma-separated list of allowed frontend origins)
ALLOWED_ORIGINS=http://localhost:3000

# Cache settings
CACHE_TTL_SECONDS=86400

# Currency Exchange API settings
CURRENCY_API_BASE_URL=
CURRENCY_API_KEY=
